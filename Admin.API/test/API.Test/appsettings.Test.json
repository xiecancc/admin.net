{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=Admin_Test;Uid=root;Pwd=123456;Port=3306;SslMode=None;",
    "DbType": "MySql",
    "IsAutoCloseConnection": true,
    "InitKeyType": "Attribute",
    "CommandTimeout": 30,
    "EnableLog": false,
    "LogLevel": "Information",
    "EnablePerformanceAnalyze": false,
    "PerformanceAnalyzeThreshold": 1000,
    "EnableReadWriteSplit": false,
    "SlaveConnectionStrings": [],
    "LanguageType": "Default"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "AdminNet_Test_",
    "Database": 0,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000
  },
  "Jwt": {
    "SecretKey": "TestSecretKeyForTestingPurposesOnly1234567890!",
    "Issuer": "Admin.NET.Test",
    "Audience": "Admin.NET.Test",
    "ExpiresInMinutes": 60,
    "RefreshTokenExpiresInDays": 7
  },
  "RateLimit": {
    "Enabled": true,
    "PartitionType": "Ip",
    "OnRejected": {
      "StatusCode": 429,
      "Message": "请求过于频繁，请稍后再试"
    },
    "DefaultPolicy": {
      "Name": "Default",
      "Algorithm": "FixedWindow",
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0,
      "QueueProcessingOrder": "OldestFirst"
    },
    "EndpointPolicies": [
      {
        "PathPattern": "/api/auth/login",
        "Method": "POST",
        "PolicyName": "LoginPolicy",
        "Algorithm": "FixedWindow",
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 0,
        "QueueLimit": 0
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": ["*"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["*"],
    "AllowCredentials": false,
    "AllowAnyOrigin": true
  }
}
