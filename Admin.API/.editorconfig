# .editorconfig 配置文件
# 基于 .NET 10 / C# 14 最新特性
# 适用于 VS Code、Visual Studio 2026 等主流 IDE

root = true

# ==================== 通用配置 ====================
[*]
# 使用 LF 作为行结束符（跨平台一致性）
end_of_line = lf

# 使用 UTF-8 编码（带 BOM）
charset = utf-8-bom

# 使用空格缩进（对应规范 2.1 节）
indent_style = space

# 缩进大小为 4 个空格（对应规范 2.1 节）
indent_size = 4

# 制表符宽度
tab_width = 4

# 移除尾随空格
trim_trailing_whitespace = true

# 文件末尾插入空行
insert_final_newline = true

# 最大行长度 120 字符（对应规范 2.3 节）
max_line_length = 120

# 连续空行最大数量
max_consecutive_empty_lines = 2

# ==================== IDE 通用设置 ====================
# 文件编码和格式化
generated_code = false

# 对象和集合初始化器的换行设置
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# 条件表达式换行设置
csharp_new_line_before_conditional_expression = true

# 查询表达式换行设置
csharp_new_line_before_query_expression = true

# ==================== VS Code 特定设置 ====================
# VS Code 编辑器行为
editor.trimAutoWhitespace = true
editor.formatOnSave = true
editor.formatOnPaste = true
editor.codeActionsOnSave = {
  "source.fixAll": true,
  "source.organizeImports": true
}

# VS Code 行尾空格显示
editor.renderWhitespace = "boundary"

# VS Code 分号自动添加
editor.formatOnType = true

# ==================== Visual Studio 2026 特定设置 ====================
# VS 2026 代码分析
roslynator.enabled = true
vs.enableCodeAnalysisOnBuild = true

# VS 2026 智能提示
vs.intellisense.showAdvancedMembers = true

# VS 2026 空白字符显示
vs.showWhitespace = true

# ==================== C# 基础格式配置 ====================
# 对应编码规范第 2 章：代码格式
[*.cs]

# 大括号风格：Allman 风格（大括号换行）- 对应规范 2.2 节
csharp_new_line_before_open_brace = all

# 表达式体成员使用规则（对应规范 2.1 节）
# 方法：不在单行使用表达式体（除非非常简单）
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
# 构造函数：不在单行使用表达式体
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
# 运算符：可以在单行使用表达式体
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
# 属性：可以在单行使用表达式体
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
# 索引器：可以在单行使用表达式体
csharp_style_expression_bodied_indexers = when_on_single_line:suggestion
# 访问器：可以在单行使用表达式体
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

# 方法声明和方法调用的参数换行
csharp_method_declaration_parameters_on_new_line = when_on_single_line
csharp_method_call_parameters_on_new_line = when_on_single_line

# 保持单行块和语句
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

# 数组初始化器样式：块样式（对应规范 6.2 节）
csharp_array_initializer_style = block

# using 语句排序：系统命名空间在前，按字母顺序（对应规范 2.4 节）
csharp_using_directive_placement = outside_namespace:error

# 命名空间声明：文件作用域命名空间（C# 10+，对应规范 2.1 节）
csharp_style_namespace_declarations = file_scoped:error

# ==================== 命名约定配置 ====================
# 对应编码规范第 1 章：命名约定

# 接口命名必须以 I 开头（PascalCase）- 对应规范 1.2 节
dotnet_naming_rule.interface_should_be_begins_with_i.severity = error
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# 类型参数命名以 T 开头 - 对应规范 1.2 节
dotnet_naming_rule.type_parameters_must_begin_with_t.severity = error
dotnet_naming_rule.type_parameters_must_begin_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_must_begin_with_t.style = begin_with_t

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

dotnet_naming_style.begin_with_t.required_prefix = T
dotnet_naming_style.begin_with_t.capitalization = pascal_case

# 常量命名使用 PascalCase - 对应规范 1.1 节
dotnet_naming_rule.constants_should_be_pascal_case.severity = error
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.pascal_case.capitalization = pascal_case

# 公共成员使用 PascalCase - 对应规范 1.1 节
dotnet_naming_rule.public_members_should_be_pascal_case.severity = error
dotnet_naming_rule.public_members_should_be_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.public_members.applicable_kinds = property, method, event, delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public

# 私有字段使用 camelCase 或 _camelCase - 对应规范 1.1 节
dotnet_naming_rule.private_fields_should_be_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_or_underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.camel_case_or_underscore_camel_case.capitalization = camel_case

# ==================== 代码风格基础规则 ====================
# 对应编码规范各章节的最佳实践

# 使用 var 关键字的场景（对应规范 7.2 节）
# 内置类型不使用 var
csharp_style_var_for_built_in_types = false:error
# 类型明显时可使用 var
csharp_style_var_when_type_is_apparent = true:suggestion
# 其他情况偏好显式类型
csharp_style_var_elsewhere = false:suggestion

# 使用模式匹配（对应规范 8.2 节）
csharp_style_pattern_matching_over_is_with_cast = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:warning

# 使用局部函数而非 lambda（对应规范 5.3 节）
csharp_style_prefer_local_functions = true:suggestion

# 使用对象初始化器
dotnet_diagnostic.IDE0017.severity = error

# 使用集合初始化器
dotnet_diagnostic.IDE0028.severity = error

# 使用自动实现属性
dotnet_diagnostic.IDE0032.severity = error

# 使用内联变量声明
dotnet_diagnostic.IDE0018.severity = error

# 使用默认字面量
dotnet_diagnostic.IDE0034.severity = error

# 使用弃元忽略未使用的变量
dotnet_diagnostic.IDE0059.severity = warning

# 使用 throw 表达式
dotnet_diagnostic.IDE0016.severity = error

# 使用条件访问运算符简化 null 检查
dotnet_diagnostic.IDE0031.severity = error

# 使用空值合并运算符简化 null 检查
dotnet_diagnostic.IDE0029.severity = error

# 使用条件表达式
dotnet_diagnostic.IDE0045.severity = error
dotnet_diagnostic.IDE0046.severity = error

# 使用复合赋值
dotnet_diagnostic.IDE0054.severity = error
dotnet_diagnostic.IDE0074.severity = error

# 使用 switch 表达式替代 switch 语句（C# 8+）
dotnet_diagnostic.IDE0066.severity = suggestion

# 使用 foreach 循环提高可读性
dotnet_diagnostic.IDE0067.severity = suggestion

# 使用局部函数
dotnet_diagnostic.IDE0061.severity = suggestion

# 使用静态本地函数避免不必要的闭包分配
dotnet_diagnostic.IDE0062.severity = suggestion

# 使用简单 using 语句
dotnet_diagnostic.IDE0063.severity = error

# 使用 using 声明
dotnet_diagnostic.IDE0064.severity = error

# 使用字符串插值简化字符串连接
dotnet_diagnostic.IDE0071.severity = error

# 使用 StringBuilder 的 Append 方法链
dotnet_diagnostic.IDE0072.severity = suggestion

# 简化条件表达式
dotnet_diagnostic.IDE0075.severity = suggestion

# 使用模式匹配简化条件判断（C# 8+）- 对应规范 8.2 节
dotnet_diagnostic.IDE0078.severity = suggestion
dotnet_diagnostic.IDE0083.severity = suggestion
dotnet_diagnostic.IDE0084.severity = suggestion

# 使用递归模式匹配（C# 8+）
dotnet_diagnostic.IDE0170.severity = suggestion

# 使用列表模式（C# 11+）
dotnet_diagnostic.IDE0307.severity = suggestion

# 使用 nameof 操作符避免硬编码字符串（对应规范 11.6 节）
dotnet_diagnostic.IDE0002.severity = error

# 未使用的 using 指令
dotnet_diagnostic.IDE0005.severity = error

# ==================== C# 10+ 新特性强制规则 ====================
# 对应编码规范第 2-9 章

# 强制使用全局 using 指令（.NET 6+）
dotnet_style_require_global_usings = true:suggestion

# 强制使用 using 类型别名而非全限定名
csharp_style_using_type_alias = true:suggestion

# 强制使用集合表达式（C# 12+）- [] 而非 new List<T>() （对应规范 6.2 节）
csharp_style_prefer_collection_expression = true:suggestion

# 强制使用主构造函数（C# 12+）- 对应规范 7.2 节
csharp_style_prefer_primary_constructors = true:suggestion

# 强制使用 ref readonly 返回（C# 12+）
csharp_style_prefer_ref_readonly = true:suggestion

# 强制使用内联数组（C# 12+）
csharp_style_prefer_inline_arrays = true:suggestion

# 强制使用文件局部类型（C# 11+ file 关键字）
csharp_style_prefer_file_local_types = true:suggestion

# 强制使用原始字符串字面量（C# 11+）
csharp_style_prefer_raw_string_literals = true:suggestion

# 强制使用 UTF-8 字符串字面量（C# 12+）
csharp_style_prefer_utf8_string_literals = true:suggestion

# ==================== C# 11+ 可空性和不可变性规则 ====================
# 对应编码规范 7.1 和 7.3 节

# 使用 required 修饰符标记必须初始化的属性（C# 11+）
dotnet_diagnostic.IDE0250.severity = suggestion

# 使用 init 访问器进行不可变初始化（C# 9+）
dotnet_diagnostic.IDE0251.severity = suggestion

# 使用 record struct（C# 10+ 值类型记录）- 对应规范 3.3 节
dotnet_diagnostic.IDE0252.severity = suggestion

# 使用 with 表达式进行非破坏性修改（C# 9+）
dotnet_diagnostic.IDE0253.severity = suggestion

# 使用只读自动属性提高不可变性
dotnet_diagnostic.IDE0044.severity = suggestion

# 使用参数 null 检查（C# 11+ 参数验证模式）- 对应规范 4.3 节
dotnet_diagnostic.IDE0270.severity = error

# 使用 required 成员（C# 11+）
dotnet_diagnostic.IDE0274.severity = suggestion

# 使用命名参数提高可读性
dotnet_diagnostic.IDE0049.severity = suggestion

