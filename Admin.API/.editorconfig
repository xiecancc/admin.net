# ==================== 性能优化规则（IDE 分析器）====================
# 对应编码规范第 9 章：性能优化

# 使用 Index 和 Range 运算符（C# 8+）
dotnet_diagnostic.IDE0056.severity = suggestion
dotnet_diagnostic.IDE0058.severity = suggestion

# 使用 Span<T> 替代 Substring（高性能字符串处理）- 对应规范 9.1 节
