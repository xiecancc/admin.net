# .editorconfig 配置文件
# 基于 C# 13 / .NET 10 最新特性
# 适用于 VS Code、Visual Studio 2026 等主流 IDE

root = true

# ==================== 通用配置 ====================
[*]
# 使用 LF 作为行结束符（跨平台一致性）
end_of_line = lf

# 使用 UTF-8 编码
charset = utf-8

# 使用空格缩进
indent_style = space

# 缩进大小为 4 个空格
indent_size = 4

# 移除尾随空格
trim_trailing_whitespace = true

# 文件末尾插入空行
insert_final_newline = true

# ==================== IDE 优化配置 ====================
# Visual Studio 2026 和 VS Code 优化设置

# 在 VS Code 中启用编辑器配置支持
generated_code = false

# 文件编码检测（VS 2026+ 和 VS Code）
charset = utf-8-bom

# 制表符宽度（VS Code 显示用）
tab_width = 4

# 最大行长度（VS Code 标尺参考）
max_line_length = 120

# 连续空行最大数量（VS 2026+）
max_consecutive_empty_lines = 2

# 保持语句在同一行（适用于简单语句）
keep_simple_blocks_in_one_line = false

# 放置简单方法在同一行
place_simple_blocks_on_same_line = false

# 对象和集合初始化器的换行设置
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# 条件表达式换行设置
csharp_new_line_before_conditional_expression = true

# 查询表达式换行设置
csharp_new_line_before_query_expression = true

# ==================== VS Code 特定设置 ====================
# VS Code 编辑器行为
editor.trimAutoWhitespace = true
editor.formatOnSave = true
editor.formatOnPaste = true
editor.codeActionsOnSave = {
  "source.fixAll": true,
  "source.organizeImports": true
}

# VS Code 代码导航
editor.gotoLocation.multipleDefinitions = "goto"
editor.gotoLocation.multipleReferences = "goto"
editor.gotoLocation.multipleImplementations = "goto"

# VS Code 行尾空格显示
editor.renderWhitespace = "boundary"

# VS Code 分号自动添加
editor.formatOnType = true

# ==================== VS 2026 特定设置 ====================
# VS 2026 代码分析
roslynator.enabled = true

# VS 2026 性能分析
vs.enableCodeAnalysisOnBuild = true

# VS 2026 调试
vs.debugger.displayFormat = "hex"

# VS 2026 智能提示
vs.intellisense.showAdvancedMembers = true

# VS 2026 行尾空格显示
vs.showWhitespace = true

# ==================== C# 基础配置 ====================
[*.cs]
# 最大行长度为 120 字符（提高可读性）
max_line_length = 120

# 保持成员在同一行
csharp_new_line_before_open_brace = all

# 保持控制块在同一行
csharp_new_line_before_open_brace = methods, properties, indexers, events

# 保持类型在同一行
csharp_new_line_before_open_brace = types

# 保持命名空间在同一行
csharp_new_line_before_open_brace = namespaces

# 保持类型成员在新行
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# 保持数组初始化器在新行
csharp_new_line_between_query_expression_clauses = true

# 保持数组元素在新行
csharp_array_initializer_style = block

# 保持表达式体成员的新行
csharp_style_expression_bodied_methods = false:error
csharp_style_expression_bodied_constructors = false:error
csharp_style_expression_bodied_operators = false:error
csharp_style_expression_bodied_properties = true:error
csharp_style_expression_bodied_indexers = true:error
csharp_style_expression_bodied_accessors = true:error

# 保持方法声明的新行
csharp_method_declaration_parameters_on_new_line = when_on_single_line
csharp_method_call_parameters_on_new_line = when_on_single_line

# 保持参数列表的新行
csharp_preserve_single_line_blocks = false

# 保持单行块的新行
csharp_preserve_single_line_statements = false

# ==================== C# 13 新特性规则 ====================
# 强制使用文件作用域命名空间（C# 10+）
csharp_style_namespace_declarations = file_scoped:error

# 强制 using 指令在命名空间之前（C# 10+）
csharp_style_using_directives_placement = outside_namespace:error

# 强制使用全局 using 指令（.NET 6+ 隐式 usings）
dotnet_style_require_global_usings = true:suggestion

# 强制使用 using 类型别名而非全限定名（C# 10+）
csharp_style_using_type_alias = true:error

# 强制使用集合表达式（C# 12+）- [] 而非 new List<T>()
csharp_style_prefer_collection_expression = true:error

# 强制使用主构造函数（C# 12+）
csharp_style_prefer_primary_constructors = true:error

# 强制使用 ref readonly 返回（C# 12+）
csharp_style_prefer_ref_readonly = true:error

# 强制使用内联数组（C# 12+）
csharp_style_prefer_inline_arrays = true:error

# 强制使用文件局部类型（C# 11+）
csharp_style_prefer_file_local_types = true:error

# 强制使用原始字符串字面量（C# 11+）
csharp_style_prefer_raw_string_literals = true:error

# 强制使用 UTF-8 字符串字面量（C# 12+）
csharp_style_prefer_utf8_string_literals = true:error

# ==================== C# 14 展望规则（预览/候选） ====================
# 阻止使用 unsafe 代码（除非必要）
dotnet_diagnostic.IDE0260.severity = suggestion

# 强制使用 checked 表达式（C# 14+）
dotnet_diagnostic.IDE0261.severity = suggestion

# 强制使用 ref 条件表达式（C# 14+）
dotnet_diagnostic.IDE0262.severity = suggestion

# 强制使用扩展成员语法（C# 14+）- 允许为现有类型添加新成员
# 语法：extension MyExtension for MyType { /* 成员定义 */ }
dotnet_diagnostic.IDE0310.severity = error

# 强制使用字段关键字（C# 14+）- 简化字段声明
# 语法：field int x;
dotnet_diagnostic.IDE0311.severity = error

# 强制使用扩展成员的访问修饰符（C# 14+）
dotnet_diagnostic.IDE0312.severity = error

# 强制使用扩展成员的命名规范（C# 14+）
dotnet_diagnostic.IDE0313.severity = error

# 强制使用扩展成员的静态修饰符（C# 14+）
dotnet_diagnostic.IDE0314.severity = error

# 强制使用扩展成员的 this 参数（C# 14+）
dotnet_diagnostic.IDE0315.severity = error

# ==================== 性能优化规则（IDE 分析器）====================
# 使用字符串插值简化字符串连接
dotnet_diagnostic.IDE0071.severity = error

# 使用 ToArray 或 ToList 时指定容量
dotnet_diagnostic.IDE0306.severity = warning

# 使用 Span<T> 替代 Substring
dotnet_diagnostic.IDE0057.severity = error

# 使用 Index 和 Range 运算符
dotnet_diagnostic.IDE0056.severity = error
dotnet_diagnostic.IDE0058.severity = error

# 使用异步方法替代同步方法
dotnet_diagnostic.IDE0070.severity = warning

# 使用 Memory<T> 替代 byte[]
dotnet_diagnostic.IDE0060.severity = warning

# 使用 StringBuilder 的 Append 方法链
dotnet_diagnostic.IDE0072.severity = suggestion

# 使用 foreach 循环替代 for 循环（可读性）
dotnet_diagnostic.IDE0067.severity = error

# 使用 switch 表达式替代 switch 语句（C# 8+）
dotnet_diagnostic.IDE0066.severity = error

# 使用模式匹配简化条件判断（C# 8+）
