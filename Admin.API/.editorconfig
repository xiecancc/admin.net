# 使用 stackalloc 替代 new 数组（短生命周期数组）
dotnet_diagnostic.CA1838.severity = suggestion

# 使用 ArrayPool<T> 共享数组（减少 GC 压力）- 对应规范 9.1 节
dotnet_diagnostic.CA1839.severity = suggestion

# 使用 StringBuilder 替代字符串连接（多次连接场景）- 对应规范 9.2 节
dotnet_diagnostic.CA1840.severity = suggestion

# 使用 string.Create 替代字符串格式化（高性能场景）
dotnet_diagnostic.CA1841.severity = suggestion

# 使用 span.Contains/IndexOf/SequenceEqual 等（可读性和性能）
dotnet_diagnostic.CA1842.severity = suggestion
dotnet_diagnostic.CA1843.severity = suggestion
dotnet_diagnostic.CA1844.severity = suggestion

# 使用 Any() 替代 Count() > 0（LINQ 性能优化）
dotnet_diagnostic.CA1860.severity = error

# 使用 Count() 替代 Count 属性（可读性）
dotnet_diagnostic.CA1861.severity = suggestion

# ==================== .NET 10 性能优化规则 ====================
# 对应编码规范 9.1 和 11.5 节

# 优先使用 Memory<T> 而非 byte[]
dotnet_diagnostic.CA1837.severity = suggestion

# 优先使用 ValueTask.FromResult 替代 Task.FromResult（减少分配）
dotnet_diagnostic.CA2306.severity = suggestion

# 优先使用 ValueTask.CompletedTask 替代 Task.CompletedTask
dotnet_diagnostic.CA2307.severity = suggestion

# 优先使用 TimeProvider 替代 DateTime/TimeSpan（可测试性）
dotnet_diagnostic.CA2303.severity = suggestion

# 优先使用 PeriodicTimer 替代 Timer（性能优化）
dotnet_diagnostic.CA2304.severity = suggestion

# 优先使用 AsyncLocal<T> 替代 ThreadLocal<T>（异步安全）
dotnet_diagnostic.CA2305.severity = suggestion

# 优先使用 FrozenDictionary/Create 等高性能集合
dotnet_diagnostic.CA2299.severity = suggestion

# 优先使用 OrderedDictionary 替代 SortedDictionary
dotnet_diagnostic.CA2300.severity = suggestion

# 优先使用 PriorityQueue 替代自定义优先队列
dotnet_diagnostic.CA2301.severity = suggestion

# 优先使用 RateLimiter 替代自定义限流
dotnet_diagnostic.CA2302.severity = suggestion

# 优先使用 SearchValues.Create 替代字符串数组（搜索优化）
dotnet_diagnostic.CA2297.severity = suggestion

# 优先使用 CompositeFormat.Parse 替代字符串格式化
dotnet_diagnostic.CA2296.severity = suggestion

# 优先使用 StringPool.Shared 替代字符串常量（内存优化）
dotnet_diagnostic.CA2295.severity = suggestion

# 优先使用 TensorPrimitives 替代手动循环（向量化计算）
dotnet_diagnostic.CA2298.severity = suggestion

# 优先使用 CollectionsMarshal.AsSpan/GetValueRef（性能优化）
dotnet_diagnostic.CA2293.severity = suggestion
dotnet_diagnostic.CA2294.severity = suggestion

# 优先使用 MemoryMarshal 的高性能 API
dotnet_diagnostic.CA2290.severity = suggestion
dotnet_diagnostic.CA2291.severity = suggestion
dotnet_diagnostic.CA2292.severity = suggestion

# ==================== 内存安全与代码质量规则 ====================
# 对应编码规范第 10 章：安全最佳实践

# 未使用的私有字段
dotnet_diagnostic.CA1823.severity = warning

# 未使用的私有方法
dotnet_diagnostic.CA1811.severity = warning

# 未使用的参数
dotnet_diagnostic.CA1801.severity = warning

# 未使用的局部变量
dotnet_diagnostic.CA1804.severity = warning

# 未使用的返回值
dotnet_diagnostic.CA1806.severity = warning

# 未使用的类型
dotnet_diagnostic.CA1812.severity = suggestion

# 可以设置为常量的字段
dotnet_diagnostic.CA1802.severity = suggestion

# ==================== 可空引用类型配置 ====================
# 对应编码规范 7.3 节：可空引用类型

# 启用可空引用类型检查
dotnet_naming_rule.nullable_reference_types.severity = warning

# 允许隐式可空类型（对于遗留代码）
dotnet_code_quality.allow_implicit_nullable_types = false

# 可空引用类型的警告级别
nullable = enable

# ==================== 异步编程规则 ====================
# 对应编码规范第 5 章：异步编程

# 避免 async void（事件处理器除外）
dotnet_diagnostic.VSTHRD100.severity = error

# 使用 ConfigureAwait(false) 在库代码中
dotnet_diagnostic.VSTHRD106.severity = suggestion

# 不要在 finally 块中使用 async
dotnet_diagnostic.VSTHRD103.severity = warning

# 不要在 lock 中使用 await
dotnet_diagnostic.VSTHRD102.severity = error

# ==================== 异常处理规则 ====================
# 对应编码规范第 4 章：异常处理

# 不要捕获通用异常（对应规范 4.1 节）
dotnet_diagnostic.CA1031.severity = warning

# 不要抛出基类 Exception（对应规范 4.1 节）
dotnet_diagnostic.CA1058.severity = warning

# 使用 ArgumentNullException.ThrowIfNull（C# 10+，对应规范 4.2 节）
dotnet_diagnostic.IDE0019.severity = suggestion

# ==================== 安全最佳实践规则 ====================
# 对应编码规范第 10 章：安全最佳实践

# SQL 注入防护：使用参数化查询（对应规范 10.3 节）
dotnet_diagnostic.SCA1001.severity = error

# XSS 防护：对输出进行 HTML 编码
dotnet_diagnostic.SCA1002.severity = error

# 敏感数据不要记录到日志（对应规范 10.2 节）
dotnet_diagnostic.CA2153.severity = warning

# 不要硬编码敏感信息
dotnet_diagnostic.CA2100.severity = error

# 使用 SecureString 处理密码等敏感数据（对应规范 10.2 节）
dotnet_diagnostic.CA2122.severity = suggestion
