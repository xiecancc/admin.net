{
  "$schema": "https://raw.githubusercontent.com/dotnet/format/main/schema.json",
  "format": {
    "indentation": {
      "useTabs": false,
      "indentationSize": 4
    },
    "spacing": {
      "afterCast": true,
      "afterComma": true,
      "afterSemicolon": true,
      "aroundBinaryOperator": true,
      "aroundNullCheckOperator": true,
      "aroundTernaryOperator": true,
      "betweenEmptyMethodDeclarationParentheses": false,
      "betweenEmptyMethodCallParentheses": false,
      "betweenEmptyConstructorDeclarationParentheses": false,
      "betweenEmptyTypeParentheses": false,
      "betweenMethodDeclarationParameterParentheses": false,
      "betweenMethodCallParameterParentheses": false,
      "betweenConstructorDeclarationParameterParentheses": false,
      "betweenTypeParameterParentheses": false,
      "betweenEmptyLambdaParentheses": false,
      "betweenLambdaParameterParentheses": false,
      "beforeOpenSquareBracket": false,
      "betweenEmptySquareBrackets": false,
      "betweenSquareBrackets": true
    },
    "newLines": {
      "beforeCatch": true,
      "beforeElse": true,
      "beforeOpenBraceInTypeDeclaration": true,
      "beforeOpenBraceInMethodDeclaration": true,
      "beforeOpenBraceInPropertyDeclaration": true,
      "beforeOpenBraceInAccessorDeclaration": true,
      "beforeOpenBraceInAnonymousTypeDeclaration": true,
      "beforeOpenBraceInAnonymousMethodDeclaration": true,
      "beforeOpenBraceInLambdaExpression": true,
      "beforeOpenBraceInLocalFunction": true,
      "beforeUsingDirective": true,
      "beforeStatement": true,
      "beforeNamespaceDeclaration": true,
      "beforeTypeDeclaration": true,
      "beforeMethodDeclaration": true,
      "beforePropertyDeclaration": true,
      "beforeAccessorDeclaration": true,
      "beforeAnonymousTypeMemberDeclaration": true,
      "beforeLambdaExpression": true,
      "beforeLocalFunction": true,
      "beforeSwitchLabel": true,
      "beforeCaseLabel": true,
      "beforeDefaultLabel": true,
      "afterUsingDirective": 1,
      "afterNamespaceDeclaration": 1,
      "afterTypeDeclaration": 1,
      "afterMethodDeclaration": 1,
      "afterPropertyDeclaration": 1,
      "afterAccessorDeclaration": 1,
      "afterSwitchLabel": 1,
      "afterCaseLabel": 1,
      "afterDefaultLabel": 1,
      "afterCatch": 1,
      "afterElse": 1,
      "afterStatement": 1
    },
    "wrapping": {
      "wrapLines": true,
      "maxLineLength": 120,
      "ignoreWrappingWhenConvenient": true,
      "wrapObjectAndCollectionInitializerEntries": true,
      "wrapMethodCallChain": false,
      "wrapBinaryExpression": true,
      "wrapTernaryExpression": true,
      "wrapLambdaExpression": true,
      "wrapMethodDeclarationParameters": true,
      "wrapMethodCallParameters": true,
      "wrapConstructorDeclarationParameters": true,
      "wrapTypeParameterList": true,
      "wrapLambdaParameterList": true,
      "wrapArrayInitializerEntries": true
    },
    "csharp": {
      "indentBraces": false,
      "indentCaseContents": true,
      "indentLabels": true,
      "labelPosition": "oneLess",
      "preprocessorPosition": "left",
      "preprocessorIndentSize": 0,
      "newlineBeforeElse": true,
      "newlineBeforeCatch": true,
      "newlineBeforeWhile": true,
      "newlineBeforeFinally": true,
      "newlineBeforeOpenBraceInTypeDeclaration": true,
      "newlineBeforeOpenBraceInMethodDeclaration": true,
      "newlineBeforeOpenBraceInPropertyDeclaration": true,
      "newlineBeforeOpenBraceInAccessorDeclaration": true,
      "newlineBeforeOpenBraceInAnonymousTypeDeclaration": true,
      "newlineBeforeOpenBraceInAnonymousMethodDeclaration": true,
      "newlineBeforeOpenBraceInLambdaExpression": true,
      "newlineBeforeOpenBraceInLocalFunction": true,
      "newlineBetweenUsingDirectives": "separateGroups",
      "newlineBetweenNamespaceDeclarations": true,
      "newlineBetweenTypeDeclarations": true,
      "newlineBetweenMethodDeclarations": true,
      "newlineBetweenPropertyDeclarations": true,
      "newlineBetweenAccessorDeclarations": true,
      "newlineBetweenSwitchLabels": true,
      "newlineBetweenCaseLabels": true,
      "newlineBetweenDefaultLabels": true,
      "spaceAfterCast": true,
      "spaceAfterComma": true,
      "spaceAfterSemicolon": true,
      "spaceAroundBinaryOperator": true,
      "spaceAroundNullCheckOperator": true,
      "spaceAroundTernaryOperator": true,
      "spaceBetweenEmptyMethodDeclarationParentheses": false,
      "spaceBetweenEmptyMethodCallParentheses": false,
      "spaceBetweenEmptyConstructorDeclarationParentheses": false,
      "spaceBetweenEmptyTypeParentheses": false,
      "spaceBetweenMethodDeclarationParameterParentheses": false,
      "spaceBetweenMethodCallParameterParentheses": false,
      "spaceBetweenConstructorDeclarationParameterParentheses": false,
      "spaceBetweenTypeParameterParentheses": false,
      "spaceBetweenEmptyLambdaParentheses": false,
      "spaceBetweenLambdaParameterParentheses": false,
      "spaceBeforeOpenSquareBracket": false,
      "spaceBetweenEmptySquareBrackets": false,
      "spaceBetweenSquareBrackets": true,
      "styleQualifyMemberAccess": false,
      "styleRequireBraces": true,
      "stylePreferIntrinsicPredefinedTypeKeywordInDeclaration": true,
      "stylePreferIntrinsicPredefinedTypeKeywordInMemberAccess": true,
      "stylePreferImplicitType": false,
      "stylePreferExplicitType": true,
      "stylePreferVarWhenTypeIsNotApparent": true,
      "stylePreferBraces": true,
      "styleNamespaceDeclarationMatchFolderStructure": true,
      "styleFileScopedNamespace": true,
      "styleUsingPlacement": "outsideNamespace",
      "styleRequireNullCheck": true,
      "stylePreferNullCheck": true,
      "stylePreferPatternMatching": true,
      "stylePreferSwitchExpression": true,
      "stylePreferExpressionBodiedMethods": false,
      "stylePreferExpressionBodiedConstructors": false,
      "stylePreferExpressionBodiedOperators": false,
      "stylePreferExpressionBodiedProperties": true,
      "stylePreferExpressionBodiedIndexers": true,
      "stylePreferExpressionBodiedAccessors": true,
      "stylePreferExpressionBodiedLocalFunctions": false,
      "stylePreferThrowExpression": true,
      "stylePreferObjectInitializer": true,
      "stylePreferCollectionInitializer": true,
      "stylePreferAutoProperty": true,
      "stylePreferTopLevelStatements": false,
      "stylePreferPrimaryConstructor": true,
      "stylePreferCollectionExpression": true,
      "stylePreferRefReadonly": true,
      "stylePreferInlineArray": true,
      "stylePreferFileLocalType": true,
      "stylePreferRawStringLiteral": true,
      "stylePreferUtf8StringLiteral": true,
      "stylePreferRequiredMember": true,
      "stylePreferInitOnlyProperty": true,
      "stylePreferRecordStruct": false,
      "stylePreferWithExpression": true,
      "stylePreferNativeInteger": false,
      "stylePreferFunctionPointer": false,
      "stylePreferSuppressNullableWarning": false,
      "stylePreferTargetTypedConditionalExpression": false,
      "stylePreferCovariantReturn": false,
      "stylePreferModuleInitializer": false,
      "stylePreferExtendedPartialMethods": false,
      "stylePreferNativeIntegerCasing": false,
      "stylePreferUnsignedRightShift": false,
      "stylePreferScopedModifier": false,
      "stylePreferRefStructField": false,
      "stylePreferInterceptor": false,
      "stylePreferParameterNullCheck": true,
      "stylePreferNameof": true,
      "stylePreferStaticLocalFunction": true,
      "stylePreferReadonlyAutoProperty": true,
      "stylePreferNamedArgument": false,
      "stylePreferStructReadonlyAutoProperty": true,
      "stylePreferRecordStructType": false,
      "stylePreferWithExpressionForNonDestructiveModification": true,
      "stylePreferNativeIntegerType": false,
      "stylePreferFunctionPointerForPerformance": false,
      "stylePreferSuppressNullableState": false,
      "stylePreferTargetTypedConditional": false,
      "stylePreferCovariantReturnTypes": false,
      "stylePreferModuleInitializerType": false,
      "stylePreferExtendedPartialMethodType": false,
      "stylePreferNativeIntegerCasingType": false,
      "stylePreferUnsignedRightShiftOperator": false,
      "stylePreferScopedModifierType": false,
      "stylePreferRefStructFieldType": false,
      "stylePreferInterceptorType": false,
      "stylePreferParameterNullCheckType": true,
      "stylePreferNameofType": true,
      "stylePreferStaticLocalFunctionType": true,
      "stylePreferReadonlyAutoPropertyType": true,
      "stylePreferNamedArgumentType": false,
      "stylePreferStructReadonlyAutoPropertyType": true
    }
  },
  "analyzers": {
    "enabled": true,
    "severity": {
      "correctness": "error",
      "style": "warning",
      "quality": "warning",
      "performance": "warning",
      "security": "error"
    }
  }
}
