{
  "name": "admin-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode production",
    "build": "run-s lint format type-check \"build-only {@}\" --",
    "build:test": "run-s lint format type-check \"build-only --mode test {@}\" --",
    "build:prod": "run-s lint format type-check \"build-only --mode production {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "preview:prod": "vite preview --mode production",
    "type-check": "vue-tsc --build",
    "lint": "oxlint --fix",
    "format": "oxfmt write .",
    "clean": "rimraf node_modules dist dist-ssr coverage",
    "swag": "npx nswag run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.14.0",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/tsconfig": "^0.9.0",
    "element-plus": "^2.5.0",
    "npm-run-all2": "^8.0.4",
    "nswag": "^14.1.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.78.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-inject-preload": "^3.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.5",
    "vite-plugin-cdn-import": "^1.0.1",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-inspect": "^11.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
